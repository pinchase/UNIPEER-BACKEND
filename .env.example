# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave blank to use the local SQLite database in db.sqlite3.
DATABASE_URL=

# Google OAuth (optional for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Channels / WebSockets (optional locally; Redis is recommended in production)
REDIS_URL=

# Email via Resend (required for verification and password-reset emails)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=UniPeer <noreply@mail.unipeer.me>

# Optional SMTP-compatible email settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# CORS
CORS_ALLOW_CREDENTIALS=True
# Example: ^https://.*\\.vercel\\.app$
VERCEL_ORIGIN_REGEX=^https://.*\\.vercel\\.app$
